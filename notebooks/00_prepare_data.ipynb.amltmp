    {
      "cell_type": "code",
      "source": [
        "from azure.ai.ml import MLClient\n",
        "from azure.identity import DefaultAzureCredential\n",
        "\n",
        "SUBSCRIPTION_ID = \"f3366df5-0550-438c-b31e-e437667ba4b0\"\n",
        "RESOURCE_GROUP = \"rg-mlab1-iram15\"\n",
        "WORKSPACE = \"mlw-lab1-iram15\"\n",
        "\n",
        "ml_client = MLClient(DefaultAzureCredential(), SUBSCRIPTION_ID, RESOURCE_GROUP, WORKSPACE)\n",
        "print(\"Connected to:\", ml_client.workspace_name)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Connected to: mlw-lab1-iram15\n"
