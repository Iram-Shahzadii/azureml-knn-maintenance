        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"Missing values per column:\")\n",
        "print(df.isna().sum())\n",
        "print(\"\\nData types:\")\n",
        "print(df.dtypes)\n",
        "print(\"\\nTarget balance (share of rows):\")\n",
        "print(df[\"machine_failure\"].value_counts(normalize=True).round(4))"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Missing values per column:\ntype               0\nair_temp_k         0\nprocess_temp_k     0\nrpm                0\ntorque_nm          0\ntool_wear_min      0\nmachine_failure    0\ndtype: int64\n\nData types:\ntype                object\nair_temp_k         float64\nprocess_temp_k     float64\nrpm                  int64\ntorque_nm          float64\ntool_wear_min        int64\nmachine_failure      int64\ndtype: object\n\nTarget balance (share of rows):\n0    0.9661\n1    0.0339\nName: machine_failure, dtype: float64\n"
        }
      ],
      "execution_count": 4,
      "metadata": {
        "gather": {
          "logged": 1790720273237
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df.to_csv(\"../data/ai4i_clean.csv\", index=False)\n",
        "print(\"Saved\", df.shape, \"to data/ai4i_clean.csv\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Saved (10000, 7) to data/ai4i_clean.csv\n"
        }
